# ==============================================================================
# LLM Book RAG - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your respective API keys and settings:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or API keys to version control!
# ==============================================================================

# --- LLM Provider Selection ---
# Supported options: 'ollama', 'groq', 'deepseek_api', 'openrouter'
LLM_PROVIDER=ollama

# --- 1. Ollama (Local LLM - Default) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# --- 2. Groq (High-speed Cloud Inference) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=deepseek-r1-distill-llama-70b

# --- 3. DeepSeek Official API ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-reasoner

# --- 4. OpenRouter API ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-r1

# --- HuggingFace Embedding Model ---
# Popular choices:
# - 'sentence-transformers/all-MiniLM-L6-v2' (fast, lightweight, default)
# - 'BAAI/bge-small-en-v1.5' (high accuracy)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Semantic Chunking Settings ---
# Breakpoint threshold type: 'percentile', 'standard_deviation', 'interquartile'
BREAKPOINT_THRESHOLD_TYPE=percentile
BREAKPOINT_THRESHOLD_AMOUNT=95.0

# --- Retrieval & RAG Settings ---
TOP_K_CHUNKS=3

# --- Storage Directories ---
DATA_RAW_DIR=data/raw
VECTOR_STORE_DIR=data/vectorstore
